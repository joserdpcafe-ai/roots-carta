# Cabeceras para Cloudflare Pages. Las genera armar_pwa.py.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/huella.json
  Cache-Control: no-cache
/img/*
  Cache-Control: public, max-age=86400
/icons/*
  Cache-Control: public, max-age=86400
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' https://kxmnnrdfmobzcaomlsjs.supabase.co; manifest-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'
